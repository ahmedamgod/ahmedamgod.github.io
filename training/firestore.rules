rules_version = '2';
// قواعد الحماية: محدش يقدر يقرا أو يكتب غير الأوفيسرز اللي ليهم حساب مفعّل.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().active == true;
    }
    function master() { return active() && profile().role == 'master'; }
    // صاحب التطبيق = حساب admin
    function owner() { return active() && request.auth.token.email == 'admin@hse.example.com'; }

    match /users/{uid} {
      allow read: if active() || (signedIn() && request.auth.uid == uid);
      // أول دخول لحساب admin بيعمل نفسه ماستر
      allow create: if master() || (
        signedIn() && request.auth.uid == uid
        && request.auth.token.email == 'admin@hse.example.com'
        && request.resource.data.role == 'master'
        && request.resource.data.active == true) || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'officer'
        && request.resource.data.active == false
        && request.resource.data.status == 'pending'
        && request.resource.data.username != 'admin');
      allow update: if owner() || (master() && resource.data.username != 'admin');
      allow delete: if owner() && resource.data.username != 'admin';
    }
    // اسم المستخدم ← حساب الدخول (للباسورد الجديد)
    match /logins/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if username != 'admin' && (master() || (signedIn() && request.resource.data.uid == request.auth.uid));
      allow update: if master() && username != 'admin';
      allow delete: if owner();
    }
    // تسجيل العمال والاندكشن من الأدمن بس
    // الأوامر الإدارية: الماستر بيبعت، والكل يقرا ويأكد الاستلام
    match /announcements/{id} {
      allow read: if active();
      allow create: if master() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if master();
      match /acks/{uid} {
        allow read: if active();
        allow create, update: if active() && uid == request.auth.uid;
        allow delete: if master();
      }
    }
    match /workers/{id} {
      allow read: if active();
      allow write: if master();
    }
    match /faces/{id} {
      allow read: if active();
      allow write: if master();
    }
    match /sessions/{id} {
      allow read: if active();
      allow create: if active() && (request.resource.data.type == 'daily' || master());
      allow update: if active();
      allow delete: if master();
    }
    match /attendance/{id} {
      allow read: if active();
      allow create: if active() && request.resource.data.officerUid == request.auth.uid
        && (request.resource.data.type == 'daily' || master());
      allow delete: if master() || (active() && (resource.data.officerUid == request.auth.uid
        || resource.data.get('officerUsername', '') == profile().username));
      allow update: if master();
    }
  }
}
